    "type": "git",
    "url": "git+https://github.com/vivid-life-theme/vivid-life-powershell.git"
  },
  "bugs": {
    "url": "https://github.com/vivid-life-theme/vivid-life-powershell/issues"
  },
  "keywords": [
    "powershell",
    "pwsh",
    "psreadline",
    "theme",
    "color-theme",
    "wcag",
    "accessibility",
    "vivid-life"
  ],
