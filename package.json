  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Michael van Laar",
    "email": "michael@van-laar.de"
  },
  "homepage": "https://github.com/vivid-life-theme/vivid-life-powershell",
